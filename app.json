{
  "expo": {
    "name": "Sistema de Consultas",
    "slug": "sistema-consultas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#79059C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiap.ec.sistemaconsultas"
    },
    "android": {
      "package": "com.fiap.ec.sistemaconsultas",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#79059C"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "8fdf31f4-c6d3-43d8-8284-21a638bc766e"
      }
    },
    "owner": "alvarezpedro"
  }
}
